{
  "name": "@treaty/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generieren": "drizzle-kit generate",
    "db:migrieren": "tsx --env-file-if-exists=.env src/db/migrieren.ts",
    "db:migrieren:test": "tsx --env-file-if-exists=.env src/db/migrieren.ts --test",
    "test": "vitest run",
    "benutzer:erster-administrator": "tsx --env-file-if-exists=.env src/kommandos/erster-administrator.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@node-rs/argon2": "^2.2.2",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
