# Vorlage für backend/.env
# Kopieren mit:  cp .env.example .env   und dann die Werte anpassen.
# Die echte .env gehört nie ins Repository (steht in .gitignore).
# Ein Wert, der beim Start in der Umgebung gesetzt ist (z. B. PORT=3001 pnpm start),
# hat Vorrang vor dem Wert in .env.

# development, test oder production
NODE_ENV=development

# Port, auf dem Node auf 127.0.0.1 lauscht. Im Betrieb 3000 (Apache leitet dorthin weiter).
PORT=3000

# Detailgrad der Logs: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
