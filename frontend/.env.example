# Vorlage für frontend/.env (nur für den Entwicklungsserver "pnpm dev").
# Kopieren mit:  cp .env.example .env
# Die echte .env gehört nie ins Repository (steht in .gitignore).

# Adresse des Backends, an die Vite Anfragen unter /api weiterleitet.
# Im Betrieb 3000. Solange das Altsystem 3000 belegt, hier 3001 eintragen.
API_ZIEL=http://127.0.0.1:3000
